# Dependencies
node_modules/

# Build outputs
release/
dist/
build/
build-output/
AUTO-QUEST.exe

# Output EXE desktop (chỉ giữ script build, không commit file .exe)
build-release/exe/
# Artifact phát hành (đã gom sẵn để upload lên Releases)
build-release/release-assets/
# Ghi chú: installer.nsh + icon.icns KHÔNG bị ignore (là input build, phải commit)
!resources/installer.nsh
!resources/icon.icns
!resources/icon-512.png
!resources/icon-256.png
!resources/icon-128.png
!resources/icon-64.png

# Cache & Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS files
.DS_Store
Thumbs.db

# Secrets & Tokens
*token*.txt
*.token
*.pem
*.key

# Thư mục tạm / rác điều tra (KHÔNG commit)
.tmp/
tmp-view/
AUTO-QUEST-main/
shots-*/
build-release/ui-preview/
build-release/wave*/

# File harness/probe sinh trong lúc dev
electron/renderer/.csp.html
electron/renderer/.probe-*.html
electron/renderer/.seq.html
electron/renderer/__probe*.html
electron/renderer/harness-*.js

# Binary đóng gói & ảnh chụp
*.AppImage
*.deb
*.dmg
*.icns.bak
