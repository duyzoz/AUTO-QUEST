{
	"name": "autoquest-web",
	"productName": "ZoZ Development",
	"version": "2.0.0",
	"description": "Auto Quest thuần web — treo Orb Discord, token chỉ nằm trong trình duyệt, không proxy, không Electron.",
	"private": true,
	"type": "commonjs",
	"author": "NgDuy (ZoZ Community)",
	"license": "MIT",
	"scripts": {
		"start": "node web/server.js",
		"build:engine": "node web/build-engine.js",
		"build:static": "node web/build-static.js",
		"build": "node web/build-static.js",
		"integrity": "node web/make-integrity.js --dev",
		"test": "node web/test/self-test.js && node web/test/mock-claim.test.js && node web/test/mock-reward.test.js",
		"verify": "node web/test/self-test.js && node web/make-integrity.js --dev",
		"check:bundle": "node web/test/check-bundle.js",
		"check:integrity": "node web/test/check-integrity.js",
		"sizes": "node web/test/bundle-sizes.js",
		"build:all": "node web/build-engine.js && node web/build-static.js"
	}
}
